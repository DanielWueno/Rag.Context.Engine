# Copia este archivo a infra/.env (ignorado por git) y ajusta las rutas de ESTA
# máquina. Ítem 12.1: infra/docker-compose.yml ya no hardcodea ninguna ruta bajo
# /Users/ — sin infra/.env, `docker compose config` cae en rutas relativas al repo
# (RAG_MODELS_DIR/RAG_LOGS_DIR) o en un volumen nombrado de Docker
# (RAG_SUMMARY_CACHE_DIR), nunca en la home de un usuario concreto.

# Directorio con los modelos ONNX ya descargados (ver infra/download-model.sh).
# Default si no se fija: ../models (relativo a infra/, es decir <repo>/models).
RAG_MODELS_DIR=/Users/DevStudio/models

# Directorio de logs de la API (mismo logs/ que ya usa el CLI).
# Default si no se fija: ../logs (relativo a infra/, es decir <repo>/logs).
RAG_LOGS_DIR=../logs

# Directorio con la caché SQLite de resúmenes de negocio generada por
# `rag ingest --con-resumen` corriendo nativo en el host (Reto A). Sin esto, el
# contenedor cae en un volumen nombrado de Docker vacío y Sources[].Resumen queda
# siempre null aunque la colección sí tenga resumen generado.
# Default si no se fija: volumen nombrado "rag-summary-cache" (vacío).
RAG_SUMMARY_CACHE_DIR=/Users/DevStudio/Library/Application Support/rag-engine

# Opcional: API key si el Qdrant de destino la exige (QDRANT__SERVICE__API_KEY en
# su propia configuración). Vacío = sin autenticación (comportamiento previo).
RAG_QDRANT_API_KEY=
