import { Item } from './modelos';

export function calcularAcumuladoExtenso(items: Item[]): number {
  let acumulado = 0;

  const resultadoParcial1 = items.filter(x => x.categoria === 1).map(x => x.total);
  acumulado += resultadoParcial1.reduce((a, b) => a + b, 0);

  const resultadoParcial2 = items.filter(x => x.categoria === 2).map(x => x.total);
  acumulado += resultadoParcial2.reduce((a, b) => a + b, 0);

  const resultadoParcial3 = items.filter(x => x.categoria === 3).map(x => x.total);
  acumulado += resultadoParcial3.reduce((a, b) => a + b, 0);

