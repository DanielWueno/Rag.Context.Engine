<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ítem 9.5: proyecto NUEVO y separado de RagEngine.Core.Tests a propósito.
         RagEngine.Core.Tests sólo referencia Core (+ Api, para el harness HTTP de
         5.f.4) y nunca a Cli, así que un test ahí sería estructuralmente incapaz de
         ver una violación de dirección de dependencias en RagEngine.Cli. Este
         proyecto referencia los tres para poder inspeccionar el código fuente real
         de Core/Api/Cli sin depender de qué otro proyecto los traiga por accidente. -->
    <ProjectReference Include="..\..\src\RagEngine.Core\RagEngine.Core.csproj" />
    <ProjectReference Include="..\..\src\RagEngine.Api\RagEngine.Api.csproj" />
    <ProjectReference Include="..\..\src\RagEngine.Cli\RagEngine.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Mutants\**\*.cs" />
    <None Include="Mutants\**\*" />
  </ItemGroup>

</Project>
