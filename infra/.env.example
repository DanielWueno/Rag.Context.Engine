# Copia este archivo a infra/.env (ignorado por git) y ajusta las rutas de ESTA
# máquina. infra/docker-compose.yml no hardcodea ninguna ruta de usuario ni ningún
# secreto: sin infra/.env, `docker compose config` cae en rutas relativas al repo o
# en volúmenes nombrados de Docker — nunca en la home de un usuario concreto, nunca
# con una clave real.
#
# Uso: `docker compose --env-file infra/.env -f infra/docker-compose.yml up -d`, o,
# corriendo desde dentro de infra/, basta con `docker compose up -d` (Compose lee
# infra/.env automáticamente cuando está en el mismo directorio que el compose).
#
# Ítem 10.6.3: une el ambiente dev/QA portable (ítem 21.1 — Qdrant propio en el
# compose) con el contrato ya publicado de main: 12.1 (clave de Qdrant), 12.8
# (loopback por defecto) y 20.1/Servidor.IA (perfil servidor de Ollama).

# ─────────────────────────────────────────────────────────────────────────────
# Rutas del host (sin valores personales; defaults relativos al repo)
# ─────────────────────────────────────────────────────────────────────────────

# Directorio con los modelos ONNX ya descargados (ver infra/download-model.sh).
# Montado de solo lectura en /models dentro del contenedor; RagEnginePaths resuelve
# el binario fp32 o _qint8_arm64 según la arquitectura REAL del contenedor — este
# compose NUNCA fuerza un binario concreto.
# Default si no se fija: ../models (relativo a infra/, es decir <repo>/models).
RAG_MODELS_DIR=

# Directorio de logs de la API (mismo logs/ que ya usa el CLI).
# Default si no se fija: ../logs (relativo a infra/, es decir <repo>/logs).
RAG_LOGS_DIR=

# Directorio del HOST para la caché SQLite de resúmenes de negocio. DEJAR VACÍO
# (recomendado): cae en el volumen nombrado "rag-api-cache", poblado solo con una
# copia consistente vía infra/qa/cargar-cache.ps1 (VACUUM INTO) — nunca el WAL que
# escribe `rag ingest --con-resumen` corriendo nativo en el host. Fijar esta
# variable a una ruta del host vuelve a montarla por bind mount (compatibilidad con
# el flujo Mac legado, un solo escritor a la vez — ver abajo) bajo tu propio riesgo:
# nunca dos escritores sobre el mismo WAL.
RAG_SUMMARY_CACHE_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# Qdrant propio del compose (ítem 21.1) — SIEMPRE en 127.0.0.1, nunca en la LAN
# ─────────────────────────────────────────────────────────────────────────────

# Versión de Qdrant — la misma que usa replicate-env/scripts/02-start-qdrant.sh.
QDRANT_IMAGE=qdrant/qdrant:v1.14.1

# Nombre/host de Qdrant tal como lo ve rag-api. "qdrant" (el servicio de este
# compose) es el default correcto para el perfil portable. El flujo legado de Mac
# (Qdrant standalone fuera de este compose) lo sobreescribe a host.docker.internal
# — ver el perfil Mac más abajo.
QDRANT_HOST=qdrant
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_PORT=6333

# Puertos publicados en el HOST (la dirección va fija a 127.0.0.1 en
# docker-compose.yml, nunca configurable). Cambiar solo el número de puerto, p. ej.
# para correr una instancia de verificación aislada en la misma máquina sin chocar
# con un Qdrant ya corriendo.
QDRANT_HTTP_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334

# Opcional (ítem 12.1): clave si el Qdrant de este compose debe exigir
# autenticación. Vacío = sin autenticación (comportamiento previo, default). Nunca
# un valor real en este archivo versionado — solo en infra/.env (git-ignorado) o en
# el entorno del proceso que invoca `docker compose`.
RAG_QDRANT_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# rag-api: publicación, nombres de contenedor e imagen (ítems 21.1 y 21.3)
# ─────────────────────────────────────────────────────────────────────────────

# Ítem 12.8: loopback por defecto si se deja vacío. Publicar más allá de
# 127.0.0.1 (LAN/VPN interna) exige fijar RAG_API_BIND explícito Y, para que el
# arranque no falle, Transport__Published=true + Qdrant:ApiKey + TLS resueltos
# (variables del PROCESO rag-api, no de este compose) — ver
# docs/configuracion.md#transportpublished--perfil-local-vs-perfil-publicado. El
# riesgo aceptado históricamente por la rama local (0.0.0.0 sin autenticación) NO
# se hereda aquí: ver _decision_de_exposicion de 10.6.3-portar-ambiente-dev-qa-x64
# en el ledger.
RAG_API_BIND=
RAG_API_PORT=

# Nombres de contenedor (parametrizados para poder correr una instancia de
# verificación aislada sin chocar con un rag-api/rag-qdrant ya corriendo en la
# misma máquina; el default de producción — rag-api/rag-qdrant — no cambia).
RAG_API_CONTAINER_NAME=
QDRANT_CONTAINER_NAME=

# Imagen de rag-api: build local por defecto. El ítem 21.3 (pipeline de Azure
# DevOps) solo cambia este valor a gruporeyes/rag-context-engine.dev:<tag> — nada
# más de infra/docker-compose.yml debería tocarse para ese cambio.
RAG_API_IMAGE=rag-api:local

# ─────────────────────────────────────────────────────────────────────────────
# Ollama / Servidor.IA (ítem 20.1, antes 17.1 local) — perfil LOCAL por defecto
# ─────────────────────────────────────────────────────────────────────────────

# Perfil LOCAL (este archivo, default): Ollama nativo del host, si lo hay; si no,
# /api/health reporta el check de Ollama como "down" — comportamiento esperado, no
# se oculta.
OLLAMA_ENDPOINT=http://host.docker.internal:11434/v1
OLLAMA_MODEL_ID=qwen2.5-coder

# Perfil SERVIDOR (Servidor.IA) — variables para un infra/.env.servidor aparte
# (NO este archivo, NUNCA versionadas con un valor real):
#   OLLAMA_ENDPOINT=https://<host-de-servidor-ia>:8443/v1
#   OLLAMA_MODEL_ID=qwen2.5-coder:14b
#   SERVIDOR_IA_CLAVE=<Bearer token real — NUNCA en un archivo versionado>
#   SERVIDOR_IA_CA_HOST=<ruta ABSOLUTA en el host al root.crt de Servidor.IA>
#   OLLAMA_CA_CONTAINER_PATH=/run/secrets/servidor-ia-root.crt (o la ruta que
#     prefieras dentro del contenedor — debe coincidir en el bind mount y en
#     Ollama__CaCertificatePath)
# Sin estas variables (perfil local, default de arriba), el bind mount de la CA
# cae a /dev/null:/dev/null (no-op) y Ollama__ApiKey/CaCertificatePath quedan
# vacíos — OllamaHttpClientFactory.Validate solo falla si Ollama__Endpoint es
# https y falta la clave, o si CaCertificatePath apunta a algo que no existe; en
# perfil local ninguna de las dos aplica.
SERVIDOR_IA_CLAVE=
SERVIDOR_IA_CA_HOST=
OLLAMA_CA_CONTAINER_PATH=

# ─────────────────────────────────────────────────────────────────────────────
# Perfil Mac (legado, arm64, Qdrant/Ollama fuera de este compose) — comentado
# ─────────────────────────────────────────────────────────────────────────────
# El Mac históricamente corrió Qdrant como un contenedor standalone
# ("qdrant-local", creado a mano, fuera de este compose) y Ollama nativo en el
# host (no en Docker, para conservar la aceleración Metal). Para seguir así sin
# romper nada, un infra/.env.mac aparte (no versionado) con:
#   RAG_MODELS_DIR=/Users/TU_USUARIO/models
#   RAG_LOGS_DIR=../logs
#   RAG_API_BIND=127.0.0.1
#   QDRANT_HOST=host.docker.internal
#   QDRANT_GRPC_PORT=6334
#   QDRANT_HTTP_PORT=6333
#   OLLAMA_ENDPOINT=http://host.docker.internal:11434/v1
# y arrancar solo rag-api, con --no-deps (si no, Compose intenta levantar también
# el servicio "qdrant" de este archivo por el depends_on):
#   docker compose --env-file infra/.env.mac up -d --no-deps rag-api
#
# La caché de resúmenes del Mac NUNCA se monta directo (bind mount) junto con un
# escritor nativo activo: usa infra/qa/cargar-cache.ps1 (copia consistente,
# VACUUM INTO) para poblar el volumen nombrado rag-api-cache.
