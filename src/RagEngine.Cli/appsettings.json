{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "RagEngine": "Information"
    }
  },
  "OnnxBrain": {
    "ModelPath": "${RAG_MODELS_DIR}/paraphrase-multilingual-MiniLM-L12-v2/model_qint8_arm64.onnx",
    "VocabPath": "${RAG_MODELS_DIR}/paraphrase-multilingual-MiniLM-L12-v2/sentencepiece.bpe.model",
    "TokenizerType": "SentencePiece",
    "MaxSequenceLength": 256,
    "BatchSize": 32,
    "EmbeddingDimensions": 384
  },
  "CrossEncoder": {
    "ModelPath": "${RAG_MODELS_DIR}/mmarco-mMiniLMv2-L12-H384-v1/model_qint8_arm64.onnx",
    "VocabPath": "${RAG_MODELS_DIR}/mmarco-mMiniLMv2-L12-H384-v1/sentencepiece.bpe.model",
    "MaxSequenceLength": 512,
    "BatchSize": 8,
    "StableGateScore": true
  },
  "Qdrant": {
    "Host": "localhost",
    "GrpcPort": 6334,
    "HttpPort": 6333,
    "DefaultCollection": "rag-engine"
  },
  "Ingestion": {
    "MaxConcurrentResumenCalls": 2
  },
  "TwoHop": {
    "Enabled": false,
    "SeedResults": 5,
    "MaxExpansionResults": 20,
    "Weight": 0.8
  },
  "Ollama": {
    "Endpoint": "http://localhost:11434/v1",
    "ModelId": "qwen2.5-coder",
    "TimeoutSeconds": 120
  },
  "RagGeneration": {
    "EnableSimpleModeSanitizer": true,
    "EnableSimpleModeResumenContext": true,
    "SimpleModeResumenCoverageThreshold": 0.5
  },
  "MetaIntent": {
    "SimilarityThreshold": 0.65
  }
}
