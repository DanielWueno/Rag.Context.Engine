{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "RagEngine": "Information"
    }
  },
  "OnnxBrain": {
    "ModelPath": "models/all-MiniLM-L6-v2/model.onnx",
    "VocabPath": "models/all-MiniLM-L6-v2/vocab.txt",
    "MaxSequenceLength": 256,
    "BatchSize": 32,
    "EmbeddingDimensions": 384
  },
  "Qdrant": {
    "Host": "localhost",
    "GrpcPort": 6334,
    "HttpPort": 6333,
    "DefaultCollection": "rag-engine"
  },
  "Ingestion": {
    "DefaultCollection": "rag-engine",
    "RepositoryName": "my-repo",
    "BatchSize": 32
  }
}
