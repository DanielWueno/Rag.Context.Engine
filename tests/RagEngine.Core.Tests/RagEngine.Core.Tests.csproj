<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RagEngine.Core\RagEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <!-- Item 11.5: tokenizador BPE real (cl100k_base, familia GPT-3.5/4) usado SOLO en
         tests como proxy de "tokens reales" para calibrar/validar la heurística de
         caracteres-por-token. No es el tokenizador exacto del LLM de generación local
         (Qwen2.5-Coder vía Ollama, sin tokenizador .NET disponible), por eso se
         documenta como estimación conservadora distinta, no como sustitución de 11.3. -->
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="1.0.2" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="Fixtures\**\*.fixture" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="GoldenMaster\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
