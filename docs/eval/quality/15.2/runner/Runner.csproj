<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ítem 15.2.2: banco de pruebas de las tres alternativas locales de resolución.
    Vive FUERA de RagEngine.slnx a propósito: `dotnet build` y `dotnet test` del
    repositorio no lo compilan, así que un prototipo no promovido no puede romper la
    build de producción ni arrastrar Roslyn/MSBuild a los hosts.

    Referencia Qdrant.Client directamente porque RagEngine.Core lo publica con
    PrivateAssets="compile" (frontera arquitectónica deliberada, ver su .csproj): el
    banco necesita construir filtros del segundo salto con semilla explícita, algo que
    el puerto público de Core no expone y que no se va a abrir para un experimento.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RagEngine.Experiment152</AssemblyName>
    <RootNamespace>RagEngine.Experiment152</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../../src/RagEngine.Core/RagEngine.Core.csproj" />
  </ItemGroup>

  <!--
    Roslyn, Microsoft.Data.Sqlite y Configuration llegan transitivamente desde
    RagEngine.Core; declararlos aqui con otra version solo provocaba NU1605. Se fija
    unicamente lo que Core NO propaga: Qdrant.Client (PrivateAssets="compile") y el
    contenedor de DI concreto.
  -->
  <ItemGroup>
    <PackageReference Include="Qdrant.Client" Version="1.14.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
  </ItemGroup>

</Project>
